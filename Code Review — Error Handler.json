      "id": "ae06a730-743d-4bce-b02a-23eea90ab6c7",
      "name": "On Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json || {};\nconst execution = data.execution || {};\nconst wf = data.workflow || {};\nconst error = execution.error || {};\nconst node = error.node || {};\nconst executionId = execution.id ? String(execution.id) : '';\nconst workflowName = wf.name || '';\nconst nodeName = node.name || '';\nconst message = error.message || 'Unknown error';\nconst combined = (nodeName ? ('[' + nodeName + '] ') : '') + message;\nreturn [{ json: {\n  execution_id: executionId,\n  workflow_name: workflowName,\n  node_name: nodeName,\n  error_message: combined\n} }];"
      },
      "id": "3b56d0f7-eb47-419c-ae1d-9229b502ba26",
      "name": "Normalize Error",
